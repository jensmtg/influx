{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strictNullChecks": true,
    "noEmit": true
  },
  "include": [
    "src/platform/obsidian/**/*.ts",
    "src/platform/cache/**/*.ts",
    "src/platform/diagnostics/**/*.ts",
    "src/platform/events/**/*.ts",
    "src/platform/react/**/*.ts",
    "src/shared/**/*.ts",
    "src/app/events/**/*.ts",
    "src/app/influx-plugin.ts",
    "src/app/influx-plugin-bootstrap.ts",
    "src/features/preview/preview-manager-dom.ts",
    "src/features/preview/preview-manager.tsx",
    "src/features/settings/settings-tab-schema.ts",
    "src/ui/influx-ui-plugin.ts",
    "src/features/settings/settings-tab-plugin.ts",
    "src/features/sidebar/influx-sidebar-plugin.ts",
    "src/features/sidebar/influx-sidebar-view.tsx",
    "src/domain/backlinks/**/*.ts",
    "src/domain/settings/**/*.ts",
    "src/domain/structured-text/**/*.ts",
    "src/ui/influx-update-helpers.ts",
    "src/ui/influx-react-component.tsx",
    "src/ui/influx-react-component-helpers.ts",
    "src/ui/influx-react-component-parts.tsx",
    "src/ui/markdown-mount.tsx",
    "src/ui/state/collapsed-state-manager.ts",
    "src/ui/influx-error-boundary.tsx",
    "src/ui/editor-dom-normalization.ts",
    "src/features/settings/settings-tab.ts",
    "src/main.tsx",
    "src/config/constants.ts",
    "src/types/**/*.ts",
    "src/features/editor/codemirror/stateful-decoration-async-state.ts",
    "src/features/editor/codemirror/stateful-decoration-set.ts",
    "src/features/editor/codemirror/async-view-plugin.ts",
    "src/features/editor/codemirror/influx-widget.tsx",
    "src/features/editor/codemirror/influx-widget-lifecycle.ts"
  ],
  "exclude": [
    "tests",
    "node_modules",
    "coverage",
    "docs"
  ]
}
