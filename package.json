{
	"name": "influx",
	"version": "3.0.0",
	"description": "Transform your Obsidian backlinks from simple links into rich, contextual excerpts. See the actual content surrounding each link, turning your note connections into genuine insights.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"serve": "docsify serve docs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"influx",
		"backlinks",
		"excerpts",
		"notes"
	],
	"author": "Jens M Gleditsch",
	"license": "MIT",
	"devDependencies": {
		"@babel/core": "^7.28.6",
		"@babel/preset-env": "^7.28.6",
		"@babel/preset-react": "^7.28.5",
		"@babel/preset-typescript": "^7.18.6",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.0.10",
		"@types/react-dom": "^19.2.3",
		"@types/react": "^19.2.9",
		"@typescript-eslint/eslint-plugin": "^8.56.0",
		"@typescript-eslint/parser": "^8.56.0",
		"builtin-modules": "^5.0.0",
		"docsify-cli": "5.0.0-rc.3",
		"esbuild": "0.27.3",
		"eslint": "^10.0.0",
		"jest": "^30.2.0",
		"obsidian": "latest",
		"ts-jest": "^29.4.6",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"uuid": "^13.0.0"
	},
	"overrides": {
		"minimatch": "^10.2.1",
		"ajv": "^8.18.0",
		"glob": "^10.3.10"
	}
}